% niż wzór wystający na margines.
\tolerance=900
\emergencystretch=2em
\hbadness=2500

% ---------------------------------------------------------------------------
% Paginy
% ---------------------------------------------------------------------------
% Po lewej tytuł rozdziału, po prawej tytuł sekcji, kapitalikami; numer strony
% zawsze na zewnątrz. Tytuł książki i autor są na stronie tytułowej.
\newcommand{\gp@headfont}{\small\scshape\color{gpgrey}\addfontfeatures{LetterSpace=5}}
\newcommand{\gp@folio}{{\normalfont\small\color{black}\thepage}}
\newcommand{\gp@dot}{{\color{gpterra}\textperiodcentered}}
% Na samym końcu książki: koniec. Napis stoi w stopce ostatniej strony (jej
% numer znamy z poprzedniego przebiegu), więc nigdy nie wymusza nowej kartki.
\newcommand{\gp@telos}{%
	\@ifundefined{PreviousTotalPages}{}{%
		\ifnum\numexpr\ReadonlyShipoutCounter+1\relax=\PreviousTotalPages\relax
			{\gp@antique\small\color{gpterra}\gp@ls[22]{ΤΕΛΟΣ}}%
		\fi}}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\gp@telos}
\fancyhead[LE]{\gp@folio\hspace{1.3em}{\gp@headfont\nouppercase{\leftmark}}}
\fancyhead[RO]{{\gp@headfont\nouppercase{\rightmark}}\hspace{1.3em}\gp@folio}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\headrule}{{\color{gprule}\hrule width\headwidth height\headrulewidth}}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
	\fancyhf{}%
	\fancyfoot[C]{\gp@dot\enspace\gp@folio\enspace\gp@dot}%
	\renewcommand{\headrulewidth}{0pt}%
}
% W paginie zostaje tylko część tytułu rozdziału sprzed dwukropka.
\def\gp@shorten#1:#2\gp@stop{\def\gp@shorttitle{#1}}
\newcommand{\gp@chaptermark}[1]{\markboth{\ifnum\value{chapter}>0 \thechapter\enspace\textperiodcentered\enspace\fi#1}{}}
\renewcommand{\chaptermark}[1]{%
	\gp@shorten#1:\gp@stop
	\expandafter\gp@chaptermark\expandafter{\gp@shorttitle}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace\textperiodcentered\enspace#1}}
% Pusta strona przed rozdziałem zaczynającym się na stronie nieparzystej
% nie dostaje paginy.
\renewcommand{\cleardoublepage}{\clearpage\if@twoside\ifodd\c@page\else
	\hbox{}\thispagestyle{empty}\newpage\fi\fi}

% ---------------------------------------------------------------------------
% Inicjały
% ---------------------------------------------------------------------------
% Pierwszy akapit rozdziału (także wtedy, gdy stoi dopiero pod tytułem pierwszej
% sekcji) zaczyna się dwuwierszowym inicjałem. Dzieje się to samo, bez znaczników
% w tekście: jeśli akapit nie zaczyna się literą (tylko cudzysłowem, wzorem albo
% ramką), rozdział po prostu inicjału nie dostaje. Wymaga LaTeX-a 2021-06+.
% Liczba wierszy ostatnio złamanego akapitu (w LuaTeX-u \prevgraf po akapicie
% wynosi tu zero, więc liczymy wiersze sami).
\newcount\gp@lines
\directlua{
	luatexbase.add_to_callback("post_linebreak_filter", function(head)
		local n = 0
		for l in node.traverse_id(node.id("hlist"), head) do
			if l.subtype == 1 then n = n + 1 end
		end
		tex.setcount("global", "gp@lines", n)
		return head
	end, "greaseproof.countlines")
}
\newif\ifgp@initial   % czeka na pierwszy akapit
\newif\ifgp@inheading % jesteśmy w tytule sekcji
\newif\ifgp@intoc
\newsavebox{\gp@initbox}
\newtoks\gp@savedeverypar
\newcommand{\gp@arminitialfront}{\if@mainmatter\else\ifgp@intoc\else\global\gp@initialtrue\fi\fi}
\IfHookExistsTF{para/begin}{%
	\AddToHook{para/begin}{%
		\ifgp@inheading\else
			\@tempswafalse
			\ifx\gp@pendingtodo\@empty\else\@tempswatrue\fi
			\ifgp@initial\@tempswatrue\fi
			% tylko akapity głównego toku tekstu: nie paginy, nie przypisy, nie wnętrza ramek
			\ifnum\directlua{tex.sprint(tex.nest.ptr)}=\@ne\else\@tempswafalse\fi
			\if@tempswa
				\if@inlabel % pierwszy akapit to punkt wyliczenia albo twierdzenie
					\global\gp@initialfalse
				\else
					\gp@savedeverypar\expandafter{\the\everypar}%
					\everypar\expandafter{\the\everypar\gp@parastart}%
				\fi
			\fi
		\fi}%
}{}
% Wykonywane na samym początku akapitu, po kodzie nagłówków i wyliczeń.
\def\gp@parastart{%
	\everypar\expandafter{\the\gp@savedeverypar}%
	\ifgp@initial\else\ifx\gp@pendingtodo\@empty\else\gp@flushtodo\fi\fi
	\ifgp@initial\expandafter\gp@tryinitial\fi}
\def\gp@tryinitial{\futurelet\gp@next\gp@tryinitial@a}
\def\gp@tryinitial@a{%
	\ifx\gp@next\@kernel@after@para@begin
		\expandafter\gp@tryinitial@skip
	\else
		\expandafter\gp@tryinitial@b
	\fi}
\def\gp@tryinitial@skip#1{#1\futurelet\gp@next\gp@tryinitial@b}
\def\gp@tryinitial@b{%
	\ifcat\noexpand\gp@next a%
		\expandafter\gp@doinitial
	\else
		\global\gp@initialfalse
	\fi}
\def\gp@doinitial#1{%
	\global\gp@initialfalse
	\begingroup
		\setbox\z@\hbox{X}\dimen@=\ht\z@
		\dimen@ii=\dimexpr\baselineskip+\dimen@\relax
		\edef\gp@initsize{\strip@pt\dimexpr\f@size pt*\dimen@ii/\dimen@\relax}%
		\global\setbox\gp@initbox\hbox{\color@begingroup\normalfont\color{gpterra}%
			\fontsize{\gp@initsize}{\gp@initsize}\selectfont#1\color@endgroup}%
	\endgroup
	\parshape=3
		\dimexpr\wd\gp@initbox+0.12em\relax \dimexpr\hsize-\wd\gp@initbox-0.12em\relax
		\dimexpr\wd\gp@initbox+0.32em\relax \dimexpr\hsize-\wd\gp@initbox-0.32em\relax
		\z@ \hsize
	\llap{\smash{\lower\baselineskip\copy\gp@initbox}\hskip0.12em}%
	\AddToHookNext{para/after}{\ifnum\gp@lines<2 \vskip\baselineskip\fi}}

% ---------------------------------------------------------------------------
% Tytuły
% ---------------------------------------------------------------------------
% Część: krótki meander, rzymska liczba, tytuł, emblemat (rysunki są
% w greaseproof-emblems.sty), a pod spodem rozdziały, które do niej należą,
% numerowane po grecku jak na swoich stronach tytułowych.
\newcommand{\gp@partafter}{%
	\vspace{2.4em}\gp@emblem{\value{part}}\par\vspace{2.6em}%
	\startcontents[parts]%
	{\hypersetup{linkcolor=.}\printcontents[parts]{p}{0}{\setcounter{tocdepth}{0}}}%
	\par\vspace{\z@ plus 1fill}}% cały luz na dół: nagłówek stoi zawsze w tym samym miejscu
\titleformat{\part}[display]
	{\normalfont\centering}
	{\parbox{\linewidth}{\centering
		\vspace*{0.55in}%
		\gp@meandershort{9}\\[2.2em]
		{\scshape\color{gpgrey}\gp@ls[14]{\MakeLowercase{\partname}}}\\[0.9em]
		{\color{gpterra}\fontsize{44}{44}\selectfont\thepart}}}
	{1.4em}
	{\fontsize{19}{26}\selectfont\addfontfeatures{LetterSpace=12}\MakeUppercase}
	[\gp@partafter]
\titlecontents{pchapter}[0pt]
	{\centering\normalfont\normalsize}
	{\makebox[2.2em][r]{\gp@antique\color{gpterra}\gp@greeknum{\thecontentslabel}}\hspace{0.9em}}
	{}
	{}
	[\vspace{0.35em}]
\pretocmd{\appendix}{\stopcontents[parts]}{}{}

% Rozdział: jak księgi Elementów, numerowany po grecku (Γʹ), z numerem
% arabskim w etykiecie nad spodem. Pod tytułem meander na całą szerokość.
\newcommand{\gp@chapterlabel}{%
	\global\gp@chapteropentrue
	\parbox[b]{\linewidth}{\raggedright
		{\scshape\color{gpgrey}\gp@ls[14]{\MakeLowercase{\@chapapp}\ \thechapter}}\\[1.1em]
		{\gp@antique\color{gpterra}\fontsize{56}{56}\selectfont
			\ifnum\value{chapter}>0 \gp@greeknum{\value{chapter}}\fi}}}
\titleformat{\chapter}[display]
	{\normalfont\raggedright}
	{\gp@chapterlabel}
	{0.5em}
	{\fontsize{26}{31}\selectfont}
	[\vskip 15pt\gp@band\global\gp@initialtrue]
\titleformat{name=\chapter,numberless}[display]
	{\normalfont\raggedright}
	{}
	{0pt}
	{\fontsize{26}{31}\selectfont}
	[\vskip 15pt\gp@band\gp@arminitialfront]
\titlespacing*{\chapter}{0pt}{0.75in}{2.6em}
\titlespacing*{name=\chapter,numberless}{0pt}{1.2in}{2.6em}
% Koniec rozdziału dostaje ornament, zanim zacznie się następny rozdział albo część.
\pretocmd{\chapter}{\gp@closechapter}{}{\ClassWarning{greaseproof}{nie udało się dodać ornamentu na końcu rozdziału}}
\pretocmd{\part}{\gp@closechapter}{}{}

\titleformat{\section}
	{\gp@inheadingtrue\normalfont\Large\bfseries\raggedright}
	{\color{gpterra}\thesection}{0.7em}{}
\titlespacing*{\section}{0pt}{1.9em plus 0.5em minus 0.2em}{0.5em}

\titleformat{\subsection}
	{\gp@inheadingtrue\normalfont\large\bfseries\raggedright}
	{\color{gpterra}\thesubsection}{0.7em}{}
\titlespacing*{\subsection}{0pt}{1.4em plus 0.4em minus 0.2em}{0.3em}

\titleformat{\subsubsection}
	{\gp@inheadingtrue\normalfont\normalsize\scshape\raggedright\addfontfeatures{LetterSpace=6}}
	{\thesubsubsection}{0.7em}{}
\titlespacing*{\subsubsection}{0pt}{1.1em plus 0.3em minus 0.1em}{0.1em}

