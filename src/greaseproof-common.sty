% Miejsce do poprawienia oznacza krzyżyk, jak w wydaniach krytycznych
% (crux desperationis, potomek obelosa aleksandryjskich filologów).
% \todofoot wpisany między akapitami nie robi osobnego wiersza z samym
% krzyżykiem (takie wiersze zostawiały nagłówki same na dole strony), tylko
% czeka na najbliższy akapit i staje obok niego na marginesie, tak jak znaki
% krytyczne w starożytnych rękopisach. Wpisany w środku zdania zostaje w zdaniu.
\newsavebox{\gp@todobox}
\def\gp@pendingtodo{}
\newcommand{\gp@todotext}[1]{\textbf{\color{red}{\gp@str@todo}}: #1}
\newcommand{\gp@todomark}[1]{\textcolor{red}{\textbf{\textdagger}\footnote{\gp@todotext{#1}}}}
\newcommand{\todofoot}[1]{%
	\ifvmode
		\ifinner\gp@todomark{#1}\else\g@addto@macro\gp@pendingtodo{\gp@onetodo{#1}}\fi
	\else
		\gp@todomark{#1}%
	\fi}
\newcommand{\gp@onetodo}[1]{%
	\setbox\gp@todobox\hbox{\unhbox\gp@todobox
		\color@begingroup\color{red}\textbf{\textdagger}\footnotemark\color@endgroup}%
	\footnotetext{\gp@todotext{#1}}}
\newcommand{\gp@flushtodo}{%
	\let\gp@todolist\gp@pendingtodo
	\global\let\gp@pendingtodo\@empty % najpierw wyczyść: przypisy też mają akapity
	\setbox\gp@todobox\hbox{}%
	\gp@todolist
	\ifdim\wd\gp@todobox>3.6em
		\box\gp@todobox\hskip0.4em % długi szereg nie zmieści się na marginesie
	\else
		\llap{\box\gp@todobox\hskip0.5em}%
	\fi}
% Gdy na krzyżyk czeka ramka, a nie akapit, przypis trafia na dół strony jeszcze
% przed ramką, a sam znak staje na marginesie obok jej pierwszego wiersza.
\newsavebox{\gp@boxtodobox}
\newif\ifgp@boxtodo
\newcommand{\gp@todobeforebox}{%
	\ifx\gp@pendingtodo\@empty\else
		\let\gp@todolist\gp@pendingtodo
		\global\let\gp@pendingtodo\@empty
		\setbox\gp@todobox\hbox{}%
		\gp@todolist
		\global\setbox\gp@boxtodobox\box\gp@todobox
		\global\gp@boxtodotrue
	\fi}
\newcommand{\gp@todoinbox}{%
	\ifgp@boxtodo
		\global\gp@boxtodofalse
		\AddToHookNext{para/begin}{%
			\llap{\box\gp@boxtodobox\hskip\dimexpr1.4em+2.2pt\relax}\kern\z@}%
	\fi}
\IfHookExistsTF{para/begin}{}{% stary LaTeX: krzyżyk zostaje w tekście
	\renewcommand{\todofoot}[1]{\gp@todomark{#1}}}

\endinput
