% ---------------------------------------------------------------------------
% Otoczenia: twierdzenia, definicje, zadania
% ---------------------------------------------------------------------------
% Treść jest prosta (nie kursywą), etykieta kapitalikami, a rodzaj wypowiedzi
% widać po lewej kresce:
%   ochra + papirus -- twierdzenia,
%   ochra           -- fakty, lematy, wnioski, hipotezy,
%   błękit          -- definicje i aksjomaty,
%   szara           -- zadania, konstrukcje, ćwiczenia,
%   bez kreski      -- przykłady i uwagi.
\newcommand{\gp@thmhead}[2]{%
	\newtheoremstyle{#1}{0pt}{0pt}{\normalfont}{}{}{}{0.7em}%
		{\strut{\scshape\color{#2}\addfontfeatures{LetterSpace=5}\thmname{##1}\thmnumber{ ##2}}%
		 \thmnote{\normalfont\ {\itshape(##3)}}}}
\gp@thmhead{gpresult}{gpterra}
\gp@thmhead{gpgiven}{gpblue}
\gp@thmhead{gptask}{gpgrey}
\newtheoremstyle{gpplain}{0.5em}{0.5em}{\normalfont}{}{}{}{0.7em}%
	{\strut{\scshape\addfontfeatures{LetterSpace=5}\thmname{#1}\thmnumber{ #2}}%
	 \thmnote{\normalfont\ {\itshape(#3)}}}

\newcounter{counter}
\numberwithin{counter}{section}

\theoremstyle{gpresult}
\newtheorem{theorem}[counter]{\gp@str@theorem}
\newtheorem{proposition}[counter]{\gp@str@proposition}
\newtheorem{lemma}[counter]{\gp@str@lemma}
\newtheorem{corollary}[counter]{\gp@str@corollary}
\newtheorem{conjecture}[counter]{\gp@str@conjecture}
\newtheorem{integral}[counter]{\gp@str@integral}
\newtheorem*{euclidelement}{\gp@str@euclidelement}
\theoremstyle{gpgiven}
\newtheorem{definition}[counter]{\gp@str@definition}
\newtheorem{axiom}[counter]{\gp@str@axiom}
\theoremstyle{gptask}
\newtheorem{problem}[counter]{\gp@str@problem}
\newtheorem{geoconstruction}[counter]{\gp@str@geoconstruction}
\newtheorem{exercise}[counter]{\gp@str@exercise}
\theoremstyle{gpplain}
\newtheorem{example}[counter]{\gp@str@example}
\newtheorem{warning}[counter]{\gp@str@warning}
\newtheorem{tobedone}[counter]{\gp@str@tobedone}

\tcbset{
	gpbase/.style={
		enhanced, breakable, parbox=false,
		frame hidden, boxrule=0pt, sharp corners,
		left=0.9em, right=0pt, top=0.1em, bottom=0.1em,
		boxsep=0pt,
		beforeafter skip balanced=0.6\baselineskip plus 0.15\baselineskip minus 0.05\baselineskip,
		lines before break=4,
		code={\gp@todobeforebox},
		before upper={\global\gp@initialfalse\gp@todoinbox},
		after upper={\gp@fixdepth},
	},
	gpbar/.style={gpbase, interior hidden, borderline west={1.4pt}{0pt}{#1}},
	gpfilled/.style={
		gpbase, colback=gppapyrus,
		borderline west={2.2pt}{0pt}{#1},
		left=0.9em, right=0.7em, top=0.55em, bottom=0.55em,
	},
}
% Ostatni wiersz ramki dostaje pełną głębokość, także gdy nie ma w nim liter
% z wydłużeniami dolnymi; dzięki temu odstępy wokół ramek są wszędzie równe.
\newcommand{\gp@fixdepth}{%
	\ifvmode
		\ifdim\lastskip>0.4\baselineskip % ramka kończy się wzorem wystawionym
			\unskip\kern0.2\baselineskip
		\else\ifdim\prevdepth>-999pt\ifdim\prevdepth<\dp\strutbox
			\kern\dimexpr\dp\strutbox-\prevdepth\relax
		\fi\fi\fi
	\fi}
% Rysunki stoją tam, gdzie je wpisano (wewnątrz ramek nic nie może pływać,
% a poza nimi i tak wszystkie mają [H]). Rysunek, w którym nic nie ma, bo
% czeka na narysowanie, nie zostawia po sobie pustego miejsca.
\newsavebox{\gp@figbox}
\renewenvironment{figure}[1][]%
	{\par\global\gp@initialfalse\setbox\gp@figbox\vbox\bgroup\color@begingroup
		\hsize\linewidth\columnwidth\linewidth
		\@parboxrestore\def\@captype{figure}\centering
		\linepenalty=2000 \lineskiplimit=0.8em \lineskip=0.8em }%
	{\par\color@endgroup\egroup
		\ifdim\dimexpr\ht\gp@figbox+\dp\gp@figbox\relax>2pt
			\par\addvspace{0.9em}\noindent\box\gp@figbox\par\addvspace{0.9em}%
		\fi}
% Puste otoczenie center (rysunek zakomentowany na później) nie zostawia dziury.
\let\gp@endcenter\endcenter
\def\endcenter{%
	\if@inlabel
		\global\@inlabelfalse
		\global\@newlistfalse
		\global\setbox\@labels\hbox{}%
	\else
		\gp@endcenter
	\fi}
\tcolorboxenvironment{theorem}{gpfilled=gpterra}
\tcolorboxenvironment{proposition}{gpbar=gpterra}
\tcolorboxenvironment{lemma}{gpbar=gpterra}
\tcolorboxenvironment{corollary}{gpbar=gpterra}
\tcolorboxenvironment{conjecture}{gpbar=gpterra}
\tcolorboxenvironment{integral}{gpbar=gpterra}
\tcolorboxenvironment{euclidelement}{gpbar=gpterra}
\tcolorboxenvironment{definition}{gpbar=gpblue}
\tcolorboxenvironment{axiom}{gpbar=gpblue}
\tcolorboxenvironment{problem}{gpbar=gpgrey!60}
\tcolorboxenvironment{geoconstruction}{gpbar=gpgrey!60}
\tcolorboxenvironment{exercise}{gpbar=gpgrey!60}

% W zadaniach i konstrukcjach liczba kroków stoi po \hfill, w \emph. Trzyma się
% w całości i staje przy prawym marginesie także wtedy, gdy musi zejść do
% następnego wiersza.
\newcommand{\gp@stepcount}{%
	\let\gp@emph\emph
	\renewcommand{\emph}[1]{\mbox{\gp@emph{##1}}}%
	\renewcommand{\hfill}{\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfil
		\parfillskip=\z@\relax}}
\AtBeginEnvironment{problem}{\gp@stepcount}
\AtBeginEnvironment{geoconstruction}{\gp@stepcount}

% Dowody: mniejszym stopniem, żeby nie konkurowały z wypowiedziami, i z tym
% zakończeniem, którego używał Euklides: ὅπερ ἔδει δεῖξαι, co było do okazania.
\renewcommand{\qedsymbol}{{\gp@antique\itshape\color{gpterra}ὅ.\,ἔ.\,δ.}}
\AtBeginEnvironment{proof}{\small}
\patchcmd{\proof}{\itshape}{\scshape\addfontfeatures{LetterSpace=5}}{}{}

