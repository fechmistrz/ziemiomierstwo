% Wspólna część klas greaseproof (wydanie polskie) i greaseproofita (włoskie).
%
% Klasy-nakładki ładują extbook, język, fonty oraz definiują napisy \gp@str@...,
% a potem wczytują ten plik. Wszystko, co dotyczy wyglądu książki, jest tutaj.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{greaseproof-common}[2026/11/15 Almanach geometryczny: skład]

% ---------------------------------------------------------------------------
% Format strony
% ---------------------------------------------------------------------------
% Kolumna ma ok. 70 znaków w wierszu; margines zewnętrzny jest szerszy od
% wewnętrznego, żeby rozkładówka miała trzy podobne pasy światła. Wysokość
% kolumny ma się do jej szerokości jak w podziale złotym (Elementy, II.11):
% 4,525 cala razy 1,618 to 7,3216 cala.
\RequirePackage[
	paperwidth=6.125in,
	paperheight=9.25in,
	inner=0.72in,
	outer=0.88in,
	top=0.93in,
	textheight=7.3216in,
	headsep=0.22in,
	headheight=14pt,
	footskip=0.4in,
	twoside,
	% showframe,
]{geometry}

\RequirePackage{graphicx}
\graphicspath{{images/}}
\RequirePackage[svgnames, table]{xcolor}
\RequirePackage{calc}
\RequirePackage{changepage}
\RequirePackage[toc]{appendix}
\RequirePackage{etoolbox}
\RequirePackage{float}
\RequirePackage[final]{microtype}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{tkz-euclide}
\RequirePackage{subcaption}
\RequirePackage{lipsum}
\RequirePackage{comment}
\RequirePackage{paralist}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[most]{tcolorbox}

% ---------------------------------------------------------------------------
% Kolory
% ---------------------------------------------------------------------------
% Paleta starożytnego malarza: czerwona ochra (rubryki: numery, etykiety
% wyników, ornamenty), błękit egipski (to, co się przyjmuje: definicje
% i aksjomaty, oraz odsyłacze) i papirus (tło twierdzeń). Wszystko na tyle
% ciemne, żeby nie zniknąć w druku czarno-białym.
\definecolor{gpterra}{HTML}{A4411F}
\definecolor{gpblue}{HTML}{1D4C7C}
\definecolor{gppapyrus}{HTML}{F6EFDD}
\definecolor{gpgrey}{HTML}{6E675E}
\colorlet{gprule}{black!22}
% Nazwy używane w starszych wersjach klasy.
\colorlet{ocre}{gpterra}
\colorlet{darkblue}{gpblue}

% ---------------------------------------------------------------------------
% Pismo pomocnicze
% ---------------------------------------------------------------------------
% Greka (numeracja ksiąg, motto, ὅ.ἔ.δ.) jest zawsze składana Alegreyą,
% niezależnie od pisma tekstu głównego.
\newfontfamily\gp@antique{Alegreya-Regular.otf}[
	BoldFont=Alegreya-Bold.otf,
	ItalicFont=Alegreya-Italic.otf,
	BoldItalicFont=Alegreya-BoldItalic.otf,
]
% Spacjowanie wersalików i kapitalików: \gp@ls[procenty]{tekst}.
\newcommand{\gp@ls}[2][8]{{\addfontfeatures{LetterSpace=#1}#2}}
% Liczby po grecku: α΄, β΄, γ΄... (szóstka jako ΣΤ, bo stigmy w Alegreyi nie ma).
\newcommand{\gp@greeknum}[1]{\ifcase#1\or
	Α\or Β\or Γ\or Δ\or Ε\or ΣΤ\or Ζ\or Η\or Θ\or Ι\or
	ΙΑ\or ΙΒ\or ΙΓ\or ΙΔ\or ΙΕ\or ΙΣΤ\or ΙΖ\or ΙΗ\or ΙΘ\or Κ\else\the\numexpr#1\relax\fi\kern0.03em ʹ}

% ---------------------------------------------------------------------------
% Ornamenty
% ---------------------------------------------------------------------------
% Meander. \gp@meander{n} rysuje n ogniw i rozciąga je dokładnie na szerokość
% wiersza; \gp@meandershort{n} rysuje n ogniw stałej wielkości.
\newcommand{\gp@meanderpath}[1]{%
	\draw[gpterra, line cap=rect, line join=miter] (0,0)
		\foreach \gp@i in {1,...,#1} {
			-- ++(0,4) -- ++(4,0) -- ++(0,-3) -- ++(-2,0) -- ++(0,1)
			-- ++(1,0) -- ++(0,1) -- ++(-2,0) -- ++(0,-3) -- ++(4,0)}
		-- ++(0,4);}
\newcommand{\gp@meander}[1]{%
	\begin{tikzpicture}[x=\dimexpr\linewidth/\numexpr5*#1\relax\relax,
			y=\dimexpr\linewidth/\numexpr5*#1\relax\relax, line width=0.55pt]
		\gp@meanderpath{#1}
	\end{tikzpicture}}
\newcommand{\gp@meandershort}[1]{%
	\begin{tikzpicture}[x=1.5pt, y=1.5pt, line width=0.55pt]
		\gp@meanderpath{#1}
	\end{tikzpicture}}
\newcommand{\gp@band}{\par\nointerlineskip\hbox to\linewidth{\hss\gp@meander{43}\hss}\par}

% Rysunek do pierwszego twierdzenia pierwszej księgi Elementów (trójkąt
% równoboczny na danym odcinku): zamyka każdy rozdział.
\newcommand{\gp@protasis}{%
	\begin{tikzpicture}[x=0.46cm, y=0.46cm, gpterra, line join=round]
		\draw[line width=0.4pt] (0,0) circle [radius=1] (1,0) circle [radius=1];
		\draw[line width=0.75pt] (0,0) -- (1,0) -- (0.5,0.8660) -- cycle;
	\end{tikzpicture}}
\newif\ifgp@chapteropen
\newcommand{\gp@closechapter}{%
	\ifgp@chapteropen
		\global\gp@chapteropenfalse
		\par\nopagebreak\vspace{1.8em}\nopagebreak
		{\centering\gp@protasis\par}%
	\fi}

% ---------------------------------------------------------------------------
% Akapity i łamanie stron
% ---------------------------------------------------------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45\baselineskip plus 0.1\baselineskip minus 0.05\baselineskip}
\linespread{1.04}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
% W tekście jest dużo wzorów, których nie wolno łamać: lepszy luźniejszy wiersz
% niż wzór wystający na margines.
\tolerance=900
\emergencystretch=2em
\hbadness=2500

% ---------------------------------------------------------------------------
% Paginy
% ---------------------------------------------------------------------------
% Po lewej tytuł rozdziału, po prawej tytuł sekcji, kapitalikami; numer strony
% zawsze na zewnątrz. Tytuł książki i autor są na stronie tytułowej.
\newcommand{\gp@headfont}{\small\scshape\color{gpgrey}\addfontfeatures{LetterSpace=5}}
\newcommand{\gp@folio}{{\normalfont\small\color{black}\thepage}}
\newcommand{\gp@dot}{{\color{gpterra}\textperiodcentered}}
% Na samym końcu książki: koniec. Napis stoi w stopce ostatniej strony (jej
% numer znamy z poprzedniego przebiegu), więc nigdy nie wymusza nowej kartki.
\newcommand{\gp@telos}{%
	\@ifundefined{PreviousTotalPages}{}{%
		\ifnum\numexpr\ReadonlyShipoutCounter+1\relax=\PreviousTotalPages\relax
			{\gp@antique\small\color{gpterra}\gp@ls[22]{ΤΕΛΟΣ}}%
		\fi}}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\gp@telos}
\fancyhead[LE]{\gp@folio\hspace{1.3em}{\gp@headfont\nouppercase{\leftmark}}}
\fancyhead[RO]{{\gp@headfont\nouppercase{\rightmark}}\hspace{1.3em}\gp@folio}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\headrule}{{\color{gprule}\hrule width\headwidth height\headrulewidth}}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
	\fancyhf{}%
	\fancyfoot[C]{\gp@dot\enspace\gp@folio\enspace\gp@dot}%
	\renewcommand{\headrulewidth}{0pt}%
}
\renewcommand{\chaptermark}[1]{\markboth{\ifnum\value{chapter}>0 \thechapter\enspace\textperiodcentered\enspace\fi#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace\textperiodcentered\enspace#1}}
% Pusta strona przed rozdziałem zaczynającym się na stronie nieparzystej
% nie dostaje paginy.
\renewcommand{\cleardoublepage}{\clearpage\if@twoside\ifodd\c@page\else
	\hbox{}\thispagestyle{empty}\newpage\fi\fi}

% ---------------------------------------------------------------------------
% Tytuły
% ---------------------------------------------------------------------------
% Część: rzymska liczba między dwoma krótkimi meandrami, a pod spodem rozdziały,
% które do niej należą, numerowane po grecku jak na swoich stronach tytułowych.
\newcommand{\gp@partafter}{%
	\vspace{2em}\gp@meandershort{9}\par\vspace{3.2em}%
	\startcontents[parts]%
	{\hypersetup{linkcolor=.}\printcontents[parts]{p}{0}{\setcounter{tocdepth}{0}}}}
\titleformat{\part}[display]
	{\normalfont\centering}
	{\parbox{\linewidth}{\centering
		\gp@meandershort{9}\\[2.2em]
		{\scshape\color{gpgrey}\gp@ls[14]{\MakeLowercase{\partname}}}\\[0.9em]
		{\color{gpterra}\fontsize{44}{44}\selectfont\thepart}}}
	{1.4em}
	{\fontsize{19}{26}\selectfont\addfontfeatures{LetterSpace=12}\MakeUppercase}
	[\gp@partafter]
\titlecontents{pchapter}[0pt]
	{\centering\normalfont\normalsize}
	{\makebox[2.2em][r]{\gp@antique\color{gpterra}\gp@greeknum{\thecontentslabel}}\hspace{0.9em}}
	{}
	{}
	[\vspace{0.35em}]
\pretocmd{\appendix}{\stopcontents[parts]}{}{}

% Rozdział: jak księgi Elementów, numerowany po grecku (Γʹ), z numerem
% arabskim w etykiecie nad spodem. Pod tytułem meander na całą szerokość.
\newcommand{\gp@chapterlabel}{%
	\global\gp@chapteropentrue
	\parbox[b]{\linewidth}{\raggedright
		{\scshape\color{gpgrey}\gp@ls[14]{\MakeLowercase{\@chapapp}\ \thechapter}}\\[1.1em]
		{\gp@antique\color{gpterra}\fontsize{56}{56}\selectfont
			\ifnum\value{chapter}>0 \gp@greeknum{\value{chapter}}\fi}}}
\titleformat{\chapter}[display]
	{\normalfont\raggedright}
	{\gp@chapterlabel}
	{0.5em}
	{\fontsize{23}{27}\selectfont\bfseries}
	[\vskip 15pt\gp@band]
\titleformat{name=\chapter,numberless}[display]
	{\normalfont\raggedright}
	{}
	{0pt}
	{\fontsize{23}{27}\selectfont\bfseries}
	[\vskip 15pt\gp@band]
\titlespacing*{\chapter}{0pt}{0.75in}{2.6em}
\titlespacing*{name=\chapter,numberless}{0pt}{1.2in}{2.6em}
% Koniec rozdziału dostaje ornament, zanim zacznie się następny rozdział albo część.
\pretocmd{\chapter}{\gp@closechapter}{}{\ClassWarning{greaseproof}{nie udało się dodać ornamentu na końcu rozdziału}}
\pretocmd{\part}{\gp@closechapter}{}{}

\titleformat{\section}
	{\normalfont\Large\bfseries\raggedright}
	{\color{gpterra}\thesection}{0.7em}{}
\titlespacing*{\section}{0pt}{1.9em plus 0.5em minus 0.2em}{0.5em}

\titleformat{\subsection}
	{\normalfont\large\bfseries\raggedright}
	{\color{gpterra}\thesubsection}{0.7em}{}
\titlespacing*{\subsection}{0pt}{1.4em plus 0.4em minus 0.2em}{0.3em}

\titleformat{\subsubsection}
	{\normalfont\normalsize\scshape\raggedright\addfontfeatures{LetterSpace=6}}
	{\thesubsubsection}{0.7em}{}
\titlespacing*{\subsubsection}{0pt}{1.1em plus 0.3em minus 0.1em}{0.1em}

% ---------------------------------------------------------------------------
% Spis treści
% ---------------------------------------------------------------------------
\setcounter{tocdepth}{2}
\titlecontents{part}[0em]
	{\addvspace{2em}\centering\scshape\color{gpterra}\addfontfeatures{LetterSpace=12}}
	{}
	{}
	{}
	[\vspace{0.1em}]
\titlecontents{chapter}[1.7em]
	{\addvspace{0.8em}\bfseries}
	{\contentslabel[\color{gpterra}\thecontentslabel]{1.7em}}
	{\hspace*{-1.7em}}
	{\hfill\contentspage}
	[\vspace{0.15em}]
\titlecontents{section}[3.9em]
	{\vspace{0.1em}}
	{\contentslabel[\color{gpgrey}\thecontentslabel]{2.2em}}
	{\hspace*{-2.2em}}
	{\titlerule*[0.6em]{\color{gprule}.}\contentspage}
\titlecontents{subsection}[6.5em]
	{\small\color{black!75}}
	{\contentslabel[\thecontentslabel]{2.6em}}
	{\hspace*{-2.6em}}
	{\titlerule*[0.6em]{\color{gprule}.}\contentspage}
\contentsmargin{1.6em}

% ---------------------------------------------------------------------------
% Otoczenia: twierdzenia, definicje, zadania
% ---------------------------------------------------------------------------
% Treść jest prosta (nie kursywą), etykieta kapitalikami, a rodzaj wypowiedzi
% widać po lewej kresce:
%   ochra + papirus -- twierdzenia,
%   ochra           -- fakty, lematy, wnioski, hipotezy,
%   błękit          -- definicje i aksjomaty,
%   szara           -- zadania, konstrukcje, ćwiczenia,
%   bez kreski      -- przykłady i uwagi.
\newcommand{\gp@thmhead}[2]{%
	\newtheoremstyle{#1}{0pt}{0pt}{\normalfont}{}{}{}{0.7em}%
		{\strut{\scshape\color{#2}\addfontfeatures{LetterSpace=5}\thmname{##1}\thmnumber{ ##2}}%
		 \thmnote{\normalfont\ {\itshape(##3)}}}}
\gp@thmhead{gpresult}{gpterra}
\gp@thmhead{gpgiven}{gpblue}
\gp@thmhead{gptask}{gpgrey}
\newtheoremstyle{gpplain}{0.5em}{0.5em}{\normalfont}{}{}{}{0.7em}%
	{\strut{\scshape\addfontfeatures{LetterSpace=5}\thmname{#1}\thmnumber{ #2}}%
	 \thmnote{\normalfont\ {\itshape(#3)}}}

\newcounter{counter}
\numberwithin{counter}{section}

\theoremstyle{gpresult}
\newtheorem{theorem}[counter]{\gp@str@theorem}
\newtheorem{proposition}[counter]{\gp@str@proposition}
\newtheorem{lemma}[counter]{\gp@str@lemma}
\newtheorem{corollary}[counter]{\gp@str@corollary}
\newtheorem{conjecture}[counter]{\gp@str@conjecture}
\newtheorem{integral}[counter]{\gp@str@integral}
\newtheorem*{euclidelement}{\gp@str@euclidelement}
\theoremstyle{gpgiven}
\newtheorem{definition}[counter]{\gp@str@definition}
\newtheorem{axiom}[counter]{\gp@str@axiom}
\theoremstyle{gptask}
\newtheorem{problem}[counter]{\gp@str@problem}
\newtheorem{geoconstruction}[counter]{\gp@str@geoconstruction}
\newtheorem{exercise}[counter]{\gp@str@exercise}
\theoremstyle{gpplain}
\newtheorem{example}[counter]{\gp@str@example}
\newtheorem{warning}[counter]{\gp@str@warning}
\newtheorem{tobedone}[counter]{\gp@str@tobedone}

\tcbset{
	gpbase/.style={
		enhanced, breakable, parbox=false,
		frame hidden, boxrule=0pt, sharp corners,
		left=0.9em, right=0pt, top=0.1em, bottom=0.1em,
		boxsep=0pt,
		beforeafter skip balanced=0.6\baselineskip plus 0.15\baselineskip minus 0.05\baselineskip,
		after upper={\gp@fixdepth},
	},
	gpbar/.style={gpbase, interior hidden, borderline west={1.4pt}{0pt}{#1}},
	gpfilled/.style={
		gpbase, colback=gppapyrus,
		borderline west={2.2pt}{0pt}{#1},
		left=0.9em, right=0.7em, top=0.55em, bottom=0.55em,
	},
}
% Ostatni wiersz ramki dostaje pełną głębokość, także gdy nie ma w nim liter
% z wydłużeniami dolnymi; dzięki temu odstępy wokół ramek są wszędzie równe.
\newcommand{\gp@fixdepth}{%
	\ifvmode\ifdim\prevdepth>-999pt\ifdim\prevdepth<\dp\strutbox
		\kern\dimexpr\dp\strutbox-\prevdepth\relax
	\fi\fi\fi}
% Wewnątrz ramki nic nie może pływać, więc rysunek zostaje tam, gdzie go wpisano.
\newcommand{\gp@inlinefigures}{%
	\renewenvironment{figure}[1][]%
		{\par\smallskip\noindent\minipage{\linewidth}\def\@captype{figure}\centering}%
		{\endminipage\par\smallskip}%
}
\tcbset{gpbase/.append style={before upper={\gp@inlinefigures}}}
% Puste otoczenie center (rysunek zakomentowany na później) nie zostawia dziury.
\let\gp@endcenter\endcenter
\def\endcenter{%
	\if@inlabel
		\global\@inlabelfalse
		\global\@newlistfalse
		\global\setbox\@labels\hbox{}%
	\else
		\gp@endcenter
	\fi}
\tcolorboxenvironment{theorem}{gpfilled=gpterra}
\tcolorboxenvironment{proposition}{gpbar=gpterra}
\tcolorboxenvironment{lemma}{gpbar=gpterra}
\tcolorboxenvironment{corollary}{gpbar=gpterra}
\tcolorboxenvironment{conjecture}{gpbar=gpterra}
\tcolorboxenvironment{integral}{gpbar=gpterra}
\tcolorboxenvironment{euclidelement}{gpbar=gpterra}
\tcolorboxenvironment{definition}{gpbar=gpblue}
\tcolorboxenvironment{axiom}{gpbar=gpblue}
\tcolorboxenvironment{problem}{gpbar=gpgrey!60}
\tcolorboxenvironment{geoconstruction}{gpbar=gpgrey!60}
\tcolorboxenvironment{exercise}{gpbar=gpgrey!60}

% Dowody: mniejszym stopniem, żeby nie konkurowały z wypowiedziami, i z tym
% zakończeniem, którego używał Euklides: ὅπερ ἔδει δεῖξαι, co było do okazania.
\renewcommand{\qedsymbol}{{\gp@antique\itshape\color{gpterra}ὅ.\,ἔ.\,δ.}}
\AtBeginEnvironment{proof}{\small}
\patchcmd{\proof}{\itshape}{\scshape\addfontfeatures{LetterSpace=5}}{}{}

