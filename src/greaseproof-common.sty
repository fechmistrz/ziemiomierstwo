% Akapity i łamanie stron
% ---------------------------------------------------------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45\baselineskip plus 0.1\baselineskip minus 0.05\baselineskip}
\linespread{1.04}
\raggedbottom
\clubpenalty=10000
\@clubpenalty=\clubpenalty % po nagłówku LaTeX przywraca właśnie tę wartość
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
% Wzór wystawiony ma taki sam oddech niezależnie od długości wiersza nad nim.
\g@addto@macro\normalsize{%
	\abovedisplayskip=0.6\baselineskip plus 0.2\baselineskip minus 0.1\baselineskip
	\belowdisplayskip=\abovedisplayskip
	\abovedisplayshortskip=\abovedisplayskip
	\belowdisplayshortskip=\abovedisplayskip}
\normalsize
