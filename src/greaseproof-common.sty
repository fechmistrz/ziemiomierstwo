% ---------------------------------------------------------------------------
% Matematyka
% ---------------------------------------------------------------------------
% Dwie poprawki do unicode-math, potrzebne przy każdym foncie matematycznym.
% Trójkąt jest w tych fontach wyższy od wersalików, więc go pomniejszamy
% (\gp@trianglescale ustala klasa); klamry dookoła sprawiają, że dalej działa
% zapis $S_\triangle$ bez klamer.
\providecommand{\gp@trianglescale}{0.8}
\AtBeginDocument{%
	\let\gp@triangle\triangle
	\renewcommand{\triangle}{{\mathchoice
		{\scalebox{\gp@trianglescale}{$\displaystyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\textstyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\scriptstyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\scriptscriptstyle\gp@triangle$}}}}%
}
% Symbole matematyczne w tytułach sekcji psułyby zakładki PDF.
\pdfstringdefDisableCommands{\def\pi{π}}

% ---------------------------------------------------------------------------
% Strona tytułowa i ostatnia
% ---------------------------------------------------------------------------
% ,,Wiatrak'' z dowodu twierdzenia Pitagorasa w Elementach (I.47), jedynego
% dowodu, który przytaczamy w całości: dwa jasne kwadraty i jeden ciemny.
\newcommand{\gp@windmill}{%
	\begin{tikzpicture}[x=0.5cm, y=0.5cm, line join=round, line cap=round]
		\coordinate (A) at (0,0);
		\coordinate (B) at (5,0);
		\coordinate (C) at (1.8,2.4);
		\fill[gpterra!55] (A) -- (B) -- (5,-5) -- (0,-5) -- cycle;
		\fill[gpterra!20] (A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle;
		\fill[gpterra!20] (C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
		\draw[black!70, line width=0.35pt]
			(C) -- (1.8,-5) (C) -- (0,-5) (C) -- (5,-5)
			(-2.4,1.8) -- (B) (7.4,3.2) -- (A);
		\draw[black, line width=0.7pt]
			(A) -- (B) -- (5,-5) -- (0,-5) -- cycle
			(A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle
			(C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
		\draw[black, line width=1pt] (A) -- (B) -- (C) -- cycle;
	\end{tikzpicture}}
% Nad drzwiami Akademii miał wisieć napis: niech nie wchodzi nikt, kto nie zna geometrii.
\newcommand{\gp@motto}{{\gp@antique\gp@ls[18]{ΑΓΕΩΜΕΤΡΗΤΟΣ\quad ΜΗΔΕΙΣ\quad ΕΙΣΙΤΩ}}}
\renewcommand{\maketitle}{%
	\begin{titlepage}
		\centering
		\gp@band
		\vspace{0.6in}
		{\large\gp@str@author\par}
		\vspace{1.5em}
		{\fontsize{27}{37}\selectfont\gp@ls[14]{\MakeUppercase{\gp@str@titlelines}}\par}
