% Wspólna część klas greaseproof (wydanie polskie) i greaseproofita (włoskie).
%
% Klasy-nakładki ładują extbook, język, fonty oraz definiują napisy \gp@str@...,
% a potem wczytują ten plik. Wszystko, co dotyczy wyglądu książki, jest tutaj.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{greaseproof-common}[2026/11/15 Almanach geometryczny: skład]

% ---------------------------------------------------------------------------
% Format strony
% ---------------------------------------------------------------------------
% Kolumna ma ok. 70 znaków w wierszu; margines zewnętrzny jest szerszy od
% wewnętrznego, żeby rozkładówka miała trzy podobne pasy światła. Wysokość
% kolumny ma się do jej szerokości jak w podziale złotym (Elementy, II.11):
% 4,525 cala razy 1,618 to 7,3216 cala.
\RequirePackage[
	paperwidth=6.125in,
	paperheight=9.25in,
	inner=0.72in,
	outer=0.88in,
	top=0.93in,
	textheight=7.3216in,
	headsep=0.22in,
	headheight=14pt,
	footskip=0.4in,
	twoside,
	% showframe,
]{geometry}

\RequirePackage{graphicx}
\graphicspath{{images/}}
\RequirePackage[svgnames, table]{xcolor}
\RequirePackage{calc}
\RequirePackage{changepage}
\RequirePackage[toc]{appendix}
\RequirePackage{etoolbox}
\RequirePackage{float}
\RequirePackage[final]{microtype}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{tkz-euclide}
\RequirePackage{subcaption}
\RequirePackage{lipsum}
\RequirePackage{comment}
\RequirePackage{paralist}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage[bottom]{footmisc} % przypisy na dole strony także przy nierównych kolumnach
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{greaseproof-emblems}

% ---------------------------------------------------------------------------
% Kolory
% ---------------------------------------------------------------------------
% Paleta starożytnego malarza: czerwona ochra (rubryki: numery, etykiety
% wyników, ornamenty), błękit egipski (to, co się przyjmuje: definicje
% i aksjomaty, oraz odsyłacze) i papirus (tło twierdzeń). Wszystko na tyle
% ciemne, żeby nie zniknąć w druku czarno-białym.
\definecolor{gpterra}{HTML}{A4411F}
\definecolor{gpblue}{HTML}{1D4C7C}
\definecolor{gppapyrus}{HTML}{F6EFDD}
\definecolor{gpgrey}{HTML}{6E675E}
\colorlet{gprule}{black!22}
% Nazwy używane w starszych wersjach klasy.
\colorlet{ocre}{gpterra}
\colorlet{darkblue}{gpblue}

% ---------------------------------------------------------------------------
% Pismo pomocnicze
% ---------------------------------------------------------------------------
% Greka (numeracja ksiąg, motto, ὅ.ἔ.δ.) jest zawsze składana Alegreyą,
% niezależnie od pisma tekstu głównego.
\newfontfamily\gp@antique{Alegreya-Regular.otf}[
	BoldFont=Alegreya-Bold.otf,
	ItalicFont=Alegreya-Italic.otf,
	BoldItalicFont=Alegreya-BoldItalic.otf,
]
% Spacjowanie wersalików i kapitalików: \gp@ls[procenty]{tekst}.
\newcommand{\gp@ls}[2][8]{{\addfontfeatures{LetterSpace=#1}#2}}
% Liczby po grecku: α΄, β΄, γ΄... (szóstka jako ΣΤ, bo stigmy w Alegreyi nie ma).
\newcommand{\gp@greeknum}[1]{\ifcase#1\or
	Α\or Β\or Γ\or Δ\or Ε\or ΣΤ\or Ζ\or Η\or Θ\or Ι\or
	ΙΑ\or ΙΒ\or ΙΓ\or ΙΔ\or ΙΕ\or ΙΣΤ\or ΙΖ\or ΙΗ\or ΙΘ\or Κ\else\the\numexpr#1\relax\fi\kern0.03em ʹ}

% ---------------------------------------------------------------------------
% Ornamenty
% ---------------------------------------------------------------------------
% Meander. \gp@meander{n} rysuje n ogniw i rozciąga je dokładnie na szerokość
% wiersza; \gp@meandershort{n} rysuje n ogniw stałej wielkości.
\newcommand{\gp@meanderpath}[2][gpterra]{%
	\draw[#1, line cap=rect, line join=miter] (0,0)
		\foreach \gp@i in {1,...,#2} {
			-- ++(0,4) -- ++(4,0) -- ++(0,-3) -- ++(-2,0) -- ++(0,1)
			-- ++(1,0) -- ++(0,1) -- ++(-2,0) -- ++(0,-3) -- ++(4,0)}
		-- ++(0,4);}
\newcommand{\gp@meander}[1]{%
	\begin{tikzpicture}[x=\dimexpr\linewidth/\numexpr5*#1\relax\relax,
			y=\dimexpr\linewidth/\numexpr5*#1\relax\relax, line width=0.55pt]
		\gp@meanderpath{#1}
	\end{tikzpicture}}
\newcommand{\gp@meandershort}[1]{%
	\begin{tikzpicture}[x=1.5pt, y=1.5pt, line width=0.55pt]
		\gp@meanderpath{#1}
	\end{tikzpicture}}
\newcommand{\gp@band}{\par\nointerlineskip\hbox to\linewidth{\hss\gp@meander{43}\hss}\par}

% Rysunek do pierwszego twierdzenia pierwszej księgi Elementów (trójkąt
% równoboczny na danym odcinku): zamyka każdy rozdział.
\newcommand{\gp@protasis}{%
	\begin{tikzpicture}[x=0.46cm, y=0.46cm, gpterra, line join=round]
		\draw[line width=0.4pt] (0,0) circle [radius=1] (1,0) circle [radius=1];
		\draw[line width=0.75pt] (0,0) -- (1,0) -- (0.5,0.8660) -- cycle;
	\end{tikzpicture}}
\newif\ifgp@chapteropen
\newcommand{\gp@closechapter}{%
	\ifx\gp@pendingtodo\@empty\else\par\noindent\hskip2em\gp@flushtodo\par\fi
	\ifgp@chapteropen
		\global\gp@chapteropenfalse
		\par
		% tylko wtedy, gdy na stronie jest już tekst i zostało dość miejsca
		\ifdim\pagetotal>\z@
			\ifdim\dimexpr\pagegoal-\pagetotal\relax>6\baselineskip
				\nopagebreak\vspace{1.8em}\nopagebreak
				{\centering\gp@protasis\par}%
			\fi
		\fi
	\fi}

