% Dwie poprawki do unicode-math, potrzebne przy każdym foncie matematycznym.
% Trójkąt jest w tych fontach wyższy od wersalików, więc go pomniejszamy
% (\gp@trianglescale ustala klasa); klamry dookoła sprawiają, że dalej działa
% zapis $S_\triangle$ bez klamer.
\providecommand{\gp@trianglescale}{0.8}
\AtBeginDocument{%
	\let\gp@triangle\triangle
	\renewcommand{\triangle}{{\mathchoice
		{\scalebox{\gp@trianglescale}{$\displaystyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\textstyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\scriptstyle\gp@triangle$}}%
		{\scalebox{\gp@trianglescale}{$\scriptscriptstyle\gp@triangle$}}}}%
}
% Symbole matematyczne w tytułach sekcji psułyby zakładki PDF.
\pdfstringdefDisableCommands{\def\pi{π}}

% ---------------------------------------------------------------------------
% Strona tytułowa i ostatnia
% ---------------------------------------------------------------------------
% ,,Wiatrak'' z dowodu twierdzenia Pitagorasa w Elementach (I.47), jedynego
% dowodu, który przytaczamy w całości: dwa jasne kwadraty i jeden ciemny.
\newcommand{\gp@windmill}{%
	\begin{tikzpicture}[x=0.5cm, y=0.5cm, line join=round, line cap=round]
		\coordinate (A) at (0,0);
		\coordinate (B) at (5,0);
		\coordinate (C) at (1.8,2.4);
		\fill[gpterra!55] (A) -- (B) -- (5,-5) -- (0,-5) -- cycle;
		\fill[gpterra!20] (A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle;
		\fill[gpterra!20] (C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
		\draw[black!70, line width=0.35pt]
			(C) -- (1.8,-5) (C) -- (0,-5) (C) -- (5,-5)
			(-2.4,1.8) -- (B) (7.4,3.2) -- (A);
		\draw[black, line width=0.7pt]
			(A) -- (B) -- (5,-5) -- (0,-5) -- cycle
			(A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle
			(C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
		\draw[black, line width=1pt] (A) -- (B) -- (C) -- cycle;
	\end{tikzpicture}}
% Nad drzwiami Akademii miał wisieć napis: niech nie wchodzi nikt, kto nie zna geometrii.
\newcommand{\gp@motto}{{\gp@antique\gp@ls[18]{ΑΓΕΩΜΕΤΡΗΤΟΣ\quad ΜΗΔΕΙΣ\quad ΕΙΣΙΤΩ}}}
% Okładka: czarna jak attycka waza, z fryzami z meandra i wiatrakiem Euklidesa
% w kolorze wypalonej gliny. Jest pierwszą stroną pliku; kto drukuje sam blok
% książki, może ją pominąć, usuwając \gp@cover z \maketitle.
\definecolor{gpvase}{HTML}{1A1512}
\definecolor{gpclay}{HTML}{C8562C}
\definecolor{gpcream}{HTML}{F3E8D0}
\newsavebox{\gp@coverfriezebox}
\newsavebox{\gp@coverfigurebox}
\newcommand{\gp@coverfrieze}{%
	\begin{tikzpicture}[x=1.81pt, y=1.81pt, line width=0.8pt]
		\draw[gpclay, line width=0.5pt] (0,-2.2) -- (200,-2.2) (0,6.2) -- (200,6.2);
		\gp@meanderpath[gpclay]{40}
	\end{tikzpicture}}
\newcommand{\gp@coverwindmill}{%
	\begin{tikzpicture}[x=0.62cm, y=0.62cm, line join=round, line cap=round]
		\coordinate (A) at (0,0);
		\coordinate (B) at (5,0);
		\coordinate (C) at (1.8,2.4);
		\fill[gpclay!74!black] (A) -- (B) -- (5,-5) -- (0,-5) -- cycle;
		\fill[gpclay] (A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle;
		\fill[gpclay] (C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
		\draw[gpvase, line width=0.45pt]
			(C) -- (1.8,-5) (C) -- (0,-5) (C) -- (5,-5)
			(-2.4,1.8) -- (B) (7.4,3.2) -- (A);
		\draw[gpcream, line width=0.7pt]
			(A) -- (B) -- (5,-5) -- (0,-5) -- cycle
			(A) -- (C) -- (-0.6,4.2) -- (-2.4,1.8) -- cycle
			(C) -- (B) -- (7.4,3.2) -- (4.2,5.6) -- cycle;
	\end{tikzpicture}}
\newcommand{\gp@cover}{%
	\begingroup
	\renewcommand{\thepage}{okladka-\arabic{page}}%
	\sbox{\gp@coverfriezebox}{\gp@coverfrieze}%
	\sbox{\gp@coverfigurebox}{\gp@coverwindmill}%
	\thispagestyle{empty}\null
	\begin{tikzpicture}[remember picture, overlay]
		\fill[gpvase] (current page.south west) rectangle (current page.north east);
		\node[anchor=north, inner sep=0pt] at ([yshift=-0.62in]current page.north)
			{\usebox{\gp@coverfriezebox}};
		\node[anchor=south, inner sep=0pt] at ([yshift=0.62in]current page.south)
			{\usebox{\gp@coverfriezebox}};
		\node[anchor=north, inner sep=0pt, text=gpclay, font=\large]
			at ([yshift=-1.5in]current page.north) {\gp@str@author};
		\node[anchor=base, inner sep=0pt, text=gpcream,
				font=\fontsize{29}{41}\selectfont\addfontfeatures{LetterSpace=16}]
			at ([yshift=-2.32in]current page.north) {\MakeUppercase{\gp@str@titlea}};
		\node[anchor=base, inner sep=0pt, text=gpcream,
				font=\fontsize{29}{41}\selectfont\addfontfeatures{LetterSpace=16}]
			at ([yshift=-2.89in]current page.north) {\MakeUppercase{\gp@str@titleb}};
		\node[inner sep=0pt] at ([yshift=-0.95in]current page.center)
			{\usebox{\gp@coverfigurebox}};
		\node[anchor=south, inner sep=0pt, text=gpclay, font=\small]
			at ([yshift=1.15in]current page.south) {\gp@motto};
	\end{tikzpicture}%
	\clearpage
	\thispagestyle{empty}\null\clearpage % wewnętrzna strona okładki
	\endgroup}
\renewcommand{\maketitle}{%
	\gp@cover
	\begin{titlepage}
		\centering
		\gp@band
		\vspace{0.6in}
		{\large\gp@str@author\par}
		\vspace{1.5em}
		{\fontsize{27}{37}\selectfont\gp@ls[14]{\MakeUppercase{\gp@str@titlelines}}\par}
		\vspace{1.6em}
		\gp@protasis\par
		\vfill
		\gp@windmill\par
		\vfill
		{\small\color{gpterra}\gp@motto\par}
		\vspace{1em}
		{\small\gp@ls[16]{\uppercase\expandafter{\romannumeral\year}}\par}
		\vspace{0.35in}
		\gp@band
	\end{titlepage}
	\thispagestyle{empty}\null\vfill
	{\centering\footnotesize\itshape\gp@str@colophon\par}
	\cleardoublepage
}
\AtBeginDocument{\hypersetup{pdftitle={\gp@str@title}, pdfauthor={\gp@str@pdfauthor}}}

